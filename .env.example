# Neon PostgreSQL
DATABASE_URL=

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional experimental ChatGPT/Codex subscription connection.
# Generate a 32-byte key with: openssl rand -base64 32
CODEX_OAUTH_ENCRYPTION_KEY=
# Initial model until Settings saves a server-side selection.
# Supported: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
CODEX_MODEL=gpt-5.6-terra

# GitHub for workflow triggers
GITHUB_PAT=
GITHUB_REPO=Phudit-2547/ChuMaiNichi

# Passkeys: exact HTTPS origin, no trailing slash. Locally use http://localhost:5173.
PASSKEY_ORIGIN=
# Generate once: openssl rand -hex 32. Rotation invalidates all sessions.
SESSION_SECRET=
# Existing dashboard password: only authorizes the first Passkey enrollment.
# Remove after enrollment; it cannot sign in while Passkeys are configured.
DASHBOARD_PASSWORD=
